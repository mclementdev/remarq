# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publiable (ex-« anon ») : utilisable côté navigateur
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète (ex-« service_role ») : serveur uniquement, jamais exposée au navigateur
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Anthropic (textes de mise en ligne, côté serveur uniquement) ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-opus-5-5

# --- Adresses (voir docs/DEPLOIEMENT.md §2 et §4) ---
# À définir en Production une fois sell.remarq.fr actif ; sinon l'adresse *.vercel.app est utilisée.
NEXT_PUBLIC_SITE_URL=
# Boutique Shopify (liens « retour au site ») ; défaut https://remarq.fr
NEXT_PUBLIC_SHOP_URL=https://remarq.fr

# --- E-mails de la landing du salon (Resend, côté serveur uniquement) ---
# Absente : l'e-mail est journalisé au lieu d'être envoyé.
RESEND_API_KEY=
EMAIL_FROM=Remarq <contact@remarq.fr>
EMAIL_REPLY_TO=
